# Copy to .env and fill in your own values. Never commit .env.
GOOGLE_API_KEY=your_gemini_api_key
SECRET_KEY=generate_a_long_random_value
CHAT_MODEL=gemini-2.5-flash
MAX_TURNS=40
COOKIE_SECURE=0
